@{
    Layout = null; // Pantalla limpia sin menús compartidos
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - UTEC Gestor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #212529 0%, #343a40 100%);
            height: 100vh;
        }

        .card {
            border-radius: 15px;
        }
    </style>
</head>
<body class="d-flex align-items-center">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <div class="card shadow-lg border-0 bg-white m-3">
                    <div class="card-body p-4">

                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-primary m-0">Gestor Tareas</h2>
                            <small class="text-muted text-uppercase fw-semibold">Proyecto Grupo 6 - UTEC</small>
                        </div>

                        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken() if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger py-2 small border-0 shadow-sm" role="alert">
                                    @ViewBag.Error
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">Correo Institucional</label>
                                <input type="email" name="correo" class="form-control py-2" placeholder="ejemplo@correo.com" required autocomplete="off" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-bold text-secondary">Contraseña</label>
                                <input type="password" name="password" class="form-control py-2" placeholder="••••••••" required />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                                Entrar al Sistema
                            </button>
                        }

                    </div>
                </div>

                <p class="text-center text-white-50 small mt-3">&copy; @DateTime.Now.Year - Facultad de Informática UTEC</p>
            </div>
        </div>
    </div>

</body>
</html>