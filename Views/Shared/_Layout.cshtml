<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Seguimiento de Tareas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
            color: #0d6efd !important;
        }

        footer {
            margin-top: 50px;
            padding: 20px 0;
            border-top: 1px solid #dee2e6;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            @Html.ActionLink("Gestor Tareas UTEC", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Usuarios", "Index", "Usuarios", new { area = "" }, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Proyectos", "Index", "Proyecto", new { area = "" }, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Mis Tareas", "Index", "Tareas", new { area = "" }, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Reportes", "Index", "Reportes", new { area = "" }, new { @class = "nav-link" })
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    @if (Session["UsuarioID"] != null)
                    {
                        <span class="navbar-text text-light me-3">
                            Bienvenido, <strong>@Session["NombreUsuario"]</strong>
                            <span class="badge bg-primary ms-1" style="folocalnt-size: 0.75rem;">@Session["RolUsuario"]</span>
                        </span>
                        <a href="@Url.Action("Logout", "Auth")" class="btn btn-sm btn-outline-danger fw-bold">
                            Cerrar Sesión
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Auth")" class="btn btn-sm btn-primary fw-bold">
                            Iniciar Sesión
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()

        <footer class="text-center text-muted">
            <p>&copy; @DateTime.Now.Year - Facultad de Informática UTEC - Henry Alexander</p>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>